<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Управление Адам</title>
    <link rel="icon" type="image/svg+xml" href="~/images/adam-mark.svg" />
    <link rel="preload" href="~/fonts/onest/Onest-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/golos-text/GolosText-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/theme-green.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#admin-main">К содержимому</a>
<aside class="admin-sidebar">
    <div class="admin-side-heading">
        <a class="admin-brand" href="/admin"><img src="~/images/adam-mark.svg" width="39" height="34" alt="" /><span><strong>Адам</strong><small>Администрирование</small></span></a>
        <button class="nav-toggle" type="button" aria-label="Разделы панели" aria-expanded="false" aria-controls="admin-navigation">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="/images/material-icons/admin-rounded.svg#menu"></use></svg>
        </button>
    </div>
    <nav id="admin-navigation" aria-label="Администрирование">
    @{ var path = Context.Request.Path.Value ?? ""; }
    @foreach (var (url, label, icon) in new[] {
        ("/admin", "Обзор", "dashboard"), ("/admin/users", "Пользователи", "people"), ("/admin/courses", "Курсы", "courses"),
        ("/admin/materials", "Материалы", "materials"), ("/admin/audit", "Журнал действий", "audit") })
    {
        var active = url == "/admin" ? path.TrimEnd('/') == url :
            path == url || path.StartsWith(url + "/") || url == "/admin/materials" && path.StartsWith("/admin/course-materials");
        <a href="@url" aria-current="@(active ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="/images/material-icons/admin-rounded.svg#@icon"></use></svg>@label</a>
    }
    <div class="return-profile"><a href="/profile"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="/images/material-icons/navigation-rounded.svg#account_circle"></use></svg>Вернуться в профиль</a></div>
    </nav>
</aside>
<main id="admin-main" class="admin-main" tabindex="-1">
    @if (IsSectionDefined("AdminHeading"))
    {
        @await RenderSectionAsync("AdminHeading")
    }
    else
    {
        <header class="admin-heading"><h1>@ViewData["Title"]</h1></header>
    }
    @if (TempData["AdminSuccess"] is string message) { <p class="notice" role="status">@message</p> }
    @RenderBody()
</main>
<script src="~/js/admin.js" asp-append-version="true" defer></script>
</body>
</html>
