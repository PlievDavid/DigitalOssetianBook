@using IronLanguage.Web.Services
@model IronLanguage.Web.Areas.Admin.Controllers.AdminCourseRow[]
@{
    ViewData["Title"] = "Курсы";
    var page = (int)ViewData["Page"]!;
    var query = ViewData["Query"] as string;
    var status = ViewData["Status"] as string;
}
<section class="panel">
    <form method="get">
        <label>Название или автор <input name="q" type="search" value="@query" /></label>
        <label>Статус <select name="status">
            @foreach (var item in new[] { ("", "Все"), ("published", "Опубликованные"), ("draft", "Черновики"), ("archived", "В архиве"), ("blocked", "Заблокированные") })
            {
                <option value="@item.Item1" selected="@(status == item.Item1)">@item.Item2</option>
            }
        </select></label>
        <button type="submit">Найти</button>
    </form>
    @if (Model.Length == 0) { <p>Курсы не найдены.</p> }
    <div class="table-wrap"><table>
        <thead><tr><th>Курс</th><th>Автор</th><th>Статус</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            var course = row.Item.Course;
            <tr><th><a href="/admin/courses/@course.Id">@row.Draft.Title</a></th><td>@row.Item.Author</td>
                <td>@(course.BlockReason != null ? "Заблокирован" : course.Archived ? "В архиве" : course.PublishedVersionId != null ? "Опубликован" : "Черновик")</td></tr>
        }
        </tbody>
    </table></div>
    @if (page > 1) { <a asp-action="Courses" asp-route-page="@(page - 1)" asp-route-q="@query" asp-route-status="@status">Назад</a> }
    @if (ViewData["More"] is true) { <a asp-action="Courses" asp-route-page="@(page + 1)" asp-route-q="@query" asp-route-status="@status">Дальше</a> }
</section>
