@model IronLanguage.Web.Controllers.AccountInput
@{ ViewData["Title"] = "Вход"; }
<div class="auth-scene"><section class="feature-shell narrow auth-shell"><h1>Войти</h1><p>Продолжите занятия и работу со словарём.</p>
<form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="stack-form auth-login-form">
    <div asp-validation-summary="ModelOnly" class="form-error"></div>
    <div class="auth-login-field">
        <div class="auth-login-control">
            <input asp-for="Email" type="email" autocomplete="email" placeholder=" " required aria-describedby="login-email-error"
                   aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" />
            <label asp-for="Email">Электронная почта</label>
        </div>
        <span asp-validation-for="Email" class="form-error" id="login-email-error"></span>
    </div>
    <div class="auth-login-field">
        <div class="auth-login-control">
            <input asp-for="Password" type="password" autocomplete="current-password" placeholder=" " required aria-describedby="login-password-error"
                   aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : null)" />
            <label asp-for="Password">Пароль</label>
        </div>
        <span asp-validation-for="Password" class="form-error" id="login-password-error"></span>
    </div>
    <button class="button primary" type="submit">Войти</button>
</form><p class="auth-switch">Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a></p></section></div>
