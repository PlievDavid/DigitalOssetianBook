@model IronLanguage.Web.Controllers.AccountInput
@{ ViewData["Title"] = "Вход"; }
<section class="feature-shell narrow auth-shell"><h1>Войти</h1><p>Продолжите занятия и работу со словарём.</p>
<form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="stack-form">
    <div asp-validation-summary="ModelOnly" class="form-error"></div>
    <label>Электронная почта <input asp-for="Email" type="email" autocomplete="email" required /></label><span asp-validation-for="Email" class="form-error"></span>
    <label>Пароль <input asp-for="Password" type="password" autocomplete="current-password" required /></label><span asp-validation-for="Password" class="form-error"></span>
    <button class="button primary" type="submit">Войти</button>
</form><p class="auth-switch">Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a></p></section>
