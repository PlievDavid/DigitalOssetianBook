@model IronLanguage.Web.Models.CurriculumItem[]
@{
    ViewData["Title"] = "Преподавание";
    var kind = (string)ViewData["Kind"]!;
    var query = (string)ViewData["Query"]!;
    var course = kind == "course";
}
<section class="feature-shell curriculum curriculum-library">

    <header class="curriculum-library-heading">
        <h1>Преподавание</h1>
        <a class="button primary" href="/editor/curriculum/@kind/new">@(course ? "Создать курс" : "Создать урок")</a>
    </header>
    <nav class="curriculum-library-nav" aria-label="Разделы библиотеки">
        <a href="/editor/curriculum?kind=course" aria-current="@(course ? "page" : null)">Мои курсы</a>
        <a href="/editor/curriculum?kind=lesson" aria-current="@(!course ? "page" : null)">Мои уроки</a>
        <a href="/editor">Материалы</a>
    </nav>
    <section class="curriculum-library-section">
        <form method="get" action="/editor/curriculum" class="curriculum-library-search">
            <input type="hidden" name="kind" value="@kind" />
            <label class="curriculum-field"><span class="visually-hidden">Поиск по названию</span><input type="search" name="q" value="@query" placeholder="Поиск по названию" /></label>
            <button class="button secondary" type="submit">Найти</button>
        </form>
        @if (Model.Length == 0) { <p>@(query.Length > 0 ? "Ничего не найдено." : course ? "Курсов пока нет." : "Уроков пока нет.")</p> }
        <div class="curriculum-library-list">
        @foreach (var item in Model) {
            <article class="curriculum-library-row"><div><h2><a href="/editor/curriculum/@kind/@item.Revision.ContentId/edit">@item.Document.Title</a></h2><p><span class="teaching-status @(item.Revision.Published ? "is-published" : "")">@(item.Revision.Published ? "Опубликовано" : "Черновик")</span><span class="teaching-version">Версия @item.Revision.Version</span></p>
            @if (!item.Revision.Published && item.Revision.BaseVersion > 0) { <p>Ученикам доступна опубликованная версия.</p> }</div>
            <div class="curriculum-actions"><a href="/editor/curriculum/@kind/@item.Revision.ContentId/edit">@(item.Revision.Published ? "Новая версия" : "Изменить")</a><a href="/editor/curriculum/@kind/@item.Revision.ContentId/preview">Предпросмотр</a>
                @if (course && (item.Revision.Published || item.Revision.BaseVersion > 0)) { <a href="/editor/curriculum/course/@item.Revision.ContentId/report">Отчёт по урокам</a> }
            </div></article>
        }</div>
    </section>
</section>
@section Styles { <link rel="stylesheet" href="~/css/curriculum.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/curriculum-editor-refined.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/teaching-library.css" asp-append-version="true" /> }
