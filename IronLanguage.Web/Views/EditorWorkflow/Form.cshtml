@model IronLanguage.Web.Models.EditorFormModel
@inject IronLanguage.Db.ICatalogRepository Catalog
@using System.Text.Json
@{
    var title = Model.Kind switch { "word" => "Слово", "audio" => "Аудиопазл", "translation" => "Перевод фразы", "listening" => "Аудирование", "dialogue" => "Диалог", "matching" => "Соотнесение", "picture" => "Картинка и слово", _ => "Произведение" };
    ViewData["Title"] = Model.ContentId is null ? $"Добавить: {title}" : $"Изменить: {title}";
    ViewData["PageClass"] = "editor-page";
    var action = Model.RevisionId is Guid revisionId ? $"/editor/revisions/{revisionId}/edit"
        : Model.ContentId is Guid contentId ? $"/editor/draft/{Model.Kind}/{contentId}" : $"/editor/new/{Model.Kind}";
    var words = (await Catalog.Words()).Select(x => new { id = x.Id, ossetian = x.Ossetian, russian = x.Russian }).ToArray();
}
<section class="feature-shell editor-form-shell" id="editor-form-app" data-kind="@Model.Kind">
    <header class="editor-page-heading">
        <a class="back-link" href="/editor">← К материалам</a>
        <h1>@(Model.ContentId is null ? "Добавить" : "Изменить") @(Model.Kind switch { "book" => "произведение", "picture" => "задание «Картинка и слово»", _ => title.ToLowerInvariant() })</h1>
        <p>Сохраните заполненный материал как черновик. Перед публикацией вы сможете проверить его в предпросмотре.</p>
    </header>
    <form method="post" action="@action" enctype="multipart/form-data" class="editor-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        @if (Model.Kind == "word")
        {
            <label>Осетинское слово <input asp-for="Ossetian" autocomplete="off" required maxlength="200" data-ossetian /><span asp-validation-for="Ossetian" class="form-error"></span></label>
            <label>Русский перевод <input asp-for="Russian" autocomplete="off" required maxlength="200" /><span asp-validation-for="Russian" class="form-error"></span></label>
            <label>Пример употребления <textarea asp-for="Example" rows="3" data-ossetian></textarea></label>
        }
        else if (Model.Kind is "audio" or "translation")
        {
            @if (Model.Kind == "audio")
            {
                <label>Перевод предложения <span class="field-help">Показывается ученику всегда, во время прохождения.</span><input asp-for="RussianPrompt" required /><span asp-validation-for="RussianPrompt" class="form-error"></span></label>
                <label>Правильное предложение <span class="field-help">По одному слову на строке, от 2 до 30 слов.</span><textarea asp-for="TokensText" rows="6" required data-ossetian></textarea><span asp-validation-for="TokensText" class="form-error"></span></label>
                <div class="editor-steps"><span class="editor-field-label">Варианты ответа</span><p class="field-help">К каждому слову — два отвлекающих варианта. Ученик выбирает слово из трёх, порядок вариантов сайт перемешивает.</p><div id="editor-steps"></div><input asp-for="DistractorsText" type="hidden" /><span asp-validation-for="DistractorsText" class="form-error"></span></div>
            }
            else
            {
                <label>Русская подсказка <input asp-for="RussianPrompt" required /><span asp-validation-for="RussianPrompt" class="form-error"></span></label>
                <label>Осетинский ответ <input asp-for="OssetianAnswer" required data-ossetian /><span asp-validation-for="OssetianAnswer" class="form-error"></span></label>
                <label>Слова для сборки <span class="field-help">Каждое слово — с новой строки. Добавьте также отвлекающие слова, если нужно.</span><textarea asp-for="TokensText" rows="6" required data-ossetian></textarea><span asp-validation-for="TokensText" class="form-error"></span></label>
                <label>Другие допустимые ответы <span class="field-help">Необязательно; каждый вариант с новой строки.</span><textarea asp-for="AlternativesText" rows="3" data-ossetian></textarea></label>
            }
            <label>Пояснение после ответа <textarea asp-for="Explanation" rows="3"></textarea></label>
            <div class="editor-word-picker"><label for="word-search">Связанные слова из словаря</label><p class="field-help">Ученик сможет добавить их после упражнения.</p><input id="word-search" type="search" placeholder="Найти слово или перевод" autocomplete="off" data-ossetian /><div id="word-results" class="editor-word-results"></div><div id="selected-words" class="editor-selected-words"></div><input asp-for="WordIdsCsv" type="hidden" /><span asp-validation-for="WordIdsCsv" class="form-error"></span></div>
        }
        else if (Model.Kind == "listening")
        {
            <label>Вопрос к записи <span class="field-help">Например: «О чём говорит собеседник?» Текст может быть на русском или осетинском.</span><input asp-for="RussianPrompt" autocomplete="off" required maxlength="500" /><span asp-validation-for="RussianPrompt" class="form-error"></span></label>
            <label>Четыре варианта ответа <span class="field-help">По одному варианту на строке. Порядок сохранится таким, как вы его укажете.</span><textarea asp-for="ListeningOptionsText" rows="5" required data-ossetian></textarea><span asp-validation-for="ListeningOptionsText" class="form-error"></span></label>
            <label>Правильный вариант <span class="field-help">Выберите номер строки с верным ответом.</span><select asp-for="CorrectOption"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option></select><span asp-validation-for="CorrectOption" class="form-error"></span></label>
            <label>Текст записи <span class="field-help">Необязательно. Ученик увидит его только после ответа — для разбора.</span><textarea asp-for="Transcript" rows="6" maxlength="5000" data-ossetian></textarea><span asp-validation-for="Transcript" class="form-error"></span></label>
            <label>Пояснение после ответа <span class="field-help">Необязательно.</span><textarea asp-for="Explanation" rows="3" maxlength="1000"></textarea><span asp-validation-for="Explanation" class="form-error"></span></label>
        }
        else if (Model.Kind == "book")
        {
            <label>Название произведения <input asp-for="Russian" required /><span asp-validation-for="Russian" class="form-error"></span></label>
            <label>Автор или авторы <input asp-for="Authors" required maxlength="240" /><span asp-validation-for="Authors" class="form-error"></span></label>
            <label>Сложность <select asp-for="Difficulty" required><option value="">Выберите уровень</option><option value="Начальный">Начальный</option><option value="Средний">Средний</option><option value="Продвинутый">Продвинутый</option></select><span asp-validation-for="Difficulty" class="form-error"></span></label>
            <label>Описание <textarea asp-for="Example" rows="3" required maxlength="1000"></textarea><span asp-validation-for="Example" class="form-error"></span></label>
            <label>Обложка <span class="field-help">Необязательно. PNG, JPEG или WebP до 5 МБ.</span><input asp-for="CoverImage" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" /><span asp-validation-for="CoverImage" class="form-error"></span></label>
            @if (Model.ExistingCoverImagePath is not null) { <img src="@Model.ExistingCoverImagePath" alt="Текущая обложка" style="width: 160px; height: 160px; object-fit: contain" /> }
            <label>Перевод <span class="field-help">Необязательно. До проверки доступен только редактору.</span><textarea asp-for="LiteraryTranslation" rows="6"></textarea><span asp-validation-for="LiteraryTranslation" class="form-error"></span></label>
            <label class="editor-check"><input asp-for="TranslationReviewed" /> Перевод проверен и может быть показан читателям</label>
            <div class="editor-book-heading"><h2>Главы</h2><button type="button" id="add-chapter" class="button secondary">Добавить главу</button></div>
            <p class="field-help">Вставьте текст главы. Словарные подсказки подготовятся автоматически при сохранении. Пробелы и знаки препинания сохранятся.</p>
            <div id="editor-chapters"></div>
            <input asp-for="ChaptersJson" type="hidden" /><span asp-validation-for="ChaptersJson" class="form-error"></span>
            <section class="editor-reading-art">
                <h2>Рисунки внутри текста</h2>
                <p class="field-help">Обложка и иллюстрации — отдельные изображения. Номер строки включает пустые строки; 0 — перед текстом.</p>
                <div id="editor-illustrations"></div>
                <input asp-for="IllustrationsJson" type="hidden" /><span asp-validation-for="IllustrationsJson" class="form-error"></span>
                <label>Добавить рисунок <span class="field-help">PNG, JPEG или WebP до 5 МБ. Один новый файл за сохранение.</span><input asp-for="InteriorImage" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" /><span asp-validation-for="InteriorImage" class="form-error"></span></label>
                <img id="interior-image-preview" class="editor-interior-preview" alt="Предпросмотр новой иллюстрации" hidden />
                <label>Часть произведения <select asp-for="IllustrationChapterId"></select></label>
                <label>После строки <input asp-for="IllustrationAfterLine" type="number" min="0" /></label>
                <label>Описание рисунка <input asp-for="IllustrationDescription" maxlength="400" /></label>
            </section>
        }
        else if (Model.Kind == "dialogue")
        {
            <label>Название диалога <input asp-for="DialogueTitle" autocomplete="off" required maxlength="200" data-ossetian /><span asp-validation-for="DialogueTitle" class="form-error"></span></label>
            <label>Диалект <select asp-for="Dialect" required><option value="Iron">Иронский</option><option value="Dval">Дигорский</option></select></label>
            <label>Уровень <select asp-for="Level" required>@for (var level = 1; level <= 5; level++) { <option value="@level">@level</option> }</select></label>
            @await Html.PartialAsync("_DialogueBuilder", Model)

        }
        else if (Model.Kind == "matching")
        {
            <label>Название задания <input asp-for="MatchingTitle" autocomplete="off" required maxlength="200" data-ossetian /><span asp-validation-for="MatchingTitle" class="form-error"></span></label>
            @await Html.PartialAsync("_MatchingBuilder", Model)
            <div class="editor-word-picker"><label for="word-search">Связанные слова из словаря</label><p class="field-help">Ученик сможет добавить их после упражнения.</p><input id="word-search" type="search" placeholder="Найти слово или перевод" autocomplete="off" data-ossetian /><div id="word-results" class="editor-word-results"></div><div id="selected-words" class="editor-selected-words"></div><input asp-for="WordIdsCsv" type="hidden" /><span asp-validation-for="WordIdsCsv" class="form-error"></span></div>
        }
        else if (Model.Kind == "picture")
        {
            <label>Название задания <input asp-for="PictureTitle" autocomplete="off" required maxlength="200" data-ossetian /><span asp-validation-for="PictureTitle" class="form-error"></span></label>
            @await Html.PartialAsync("_PictureBuilder", Model)
            <div class="editor-word-picker"><label for="word-search">Связанные слова из словаря</label><p class="field-help">Ученик сможет добавить их после упражнения.</p><input id="word-search" type="search" placeholder="Найти слово или перевод" autocomplete="off" data-ossetian /><div id="word-results" class="editor-word-results"></div><div id="selected-words" class="editor-selected-words"></div><input asp-for="WordIdsCsv" type="hidden" /><span asp-validation-for="WordIdsCsv" class="form-error"></span></div>
        }
        @if (Model.Kind is "word" or "audio" or "listening")
        {
            var audioRequired = Model.Kind is "audio" or "listening";
            <div class="editor-audio-field"><span class="editor-field-label">Осетинская запись @(audioRequired ? "(обязательно)" : "(необязательно)")</span><label class="editor-file-button" for="editor-audio">Выбрать запись</label><input asp-for="Audio" id="editor-audio" type="file" accept=".mp3,.ogg,.wav,audio/mpeg,audio/ogg,audio/wav" class="editor-file-input" /><span id="editor-file-name" class="field-help">@(Model.ExistingAudioPath is null ? "Файл не выбран" : "Текущая запись сохранена")</span>@if (Model.ExistingAudioPath is null) { <audio id="editor-audio-preview" controls hidden></audio> } else { <audio id="editor-audio-preview" controls src="@Model.ExistingAudioPath"></audio> }<span asp-validation-for="Audio" class="form-error"></span></div>
        }
        <div class="editor-form-actions"><button class="button primary" type="submit">Сохранить черновик</button><a class="button secondary" href="/editor">Отмена</a></div>
    </form>
</section>
<script id="editor-words-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(words))</script>
@section Scripts { <script src="~/js/letter-keys.js" asp-append-version="true" defer></script><script src="~/js/editor.js" asp-append-version="true" defer></script>
    @if (Model.Kind == "dialogue") { <script src="~/js/dialogue-builder.js" asp-append-version="true" defer></script> }
    @if (Model.Kind == "matching") { <script src="~/js/matching-builder.js" asp-append-version="true" defer></script> }
}

