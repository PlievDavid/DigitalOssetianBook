@model ErrorViewModel
@{ ViewData["Title"] = "Не удалось открыть страницу"; }
<section class="feature-shell narrow state-panel">
    <span class="section-symbol" aria-hidden="true">@await Html.PartialAsync("_NavIcon", "materials")</span>
    <h1>Не удалось открыть страницу</h1>
    <p>Попробуйте обновить страницу или вернуться к заданиям.</p>
    <a class="button primary" href="/">К заданиям</a>
    @if (Model.ShowRequestId) { <p class="state-reference">Код обращения: <code>@Model.RequestId</code></p> }
</section>
