@inject IronLanguage.Web.Services.AvatarService Avatars
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Адам</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editor.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/adam-mark.svg" />
    <link rel="preload" href="~/fonts/onest/Onest-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/golos-text/GolosText-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/theme-green.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/avatar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sections-green.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tablet-menu.css" asp-append-version="true" />
</head>
<body class="green-theme @ViewData["PageClass"]" data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <div class="site-frame">
    @{ var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/"; }
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Адам — главная">
                <img class="brand-mark" src="~/images/adam-mark.svg" width="58" height="48" alt="" />
                <span class="brand-copy"><strong>Адам</strong><small>Осетинский язык для всех</small></span>
            </a>
        <nav id="main-navigation" class="main-nav" aria-label="Разделы"><div class="nav-inner">
            <div class="nav-menu nav-menu-section">
                <a class="nav-section-link nav-menu-trigger @(currentPath == "/" || currentPath.StartsWith("/dialogs") || currentPath.StartsWith("/audio-puzzles") || currentPath.StartsWith("/translate") || currentPath.StartsWith("/listening") || currentPath.StartsWith("/matching") || currentPath.StartsWith("/picture") ? "is-current" : "")" href="/" aria-controls="practice-menu" aria-haspopup="true" aria-expanded="false">Задания</a>
                <div id="practice-menu" class="nav-menu-panel">
                    <a class="nav-menu-item" href="/audio-puzzles">Аудиопазлы</a>
                    <a class="nav-menu-item" href="/translate">Собери фразу</a>
                    <a class="nav-menu-item" href="/listening">Аудирование</a>
                    <a class="nav-menu-item" href="/dialogs">Диалоги</a>
                    <a class="nav-menu-item" href="/matching">Соотнесение</a>
                    <a class="nav-menu-item" href="/picture">Картинка и слово</a>
                </div>
            </div>
            <div class="nav-menu nav-menu-words nav-menu-section">
                <a class="nav-section-link nav-menu-trigger @(currentPath.StartsWith("/vocabulary") || currentPath.StartsWith("/word-practice") || currentPath == "/game" ? "is-current" : "")" href="/vocabulary" aria-controls="words-menu" aria-haspopup="true" aria-expanded="false">Слова</a>
                <div id="words-menu" class="nav-menu-panel">
                    <a class="nav-menu-item" href="/vocabulary">@(User.Identity?.IsAuthenticated == true ? "Мои слова" : "Словарь")</a>
                    <a class="nav-menu-item" href="/word-practice">Тренировка слов</a>
                    <a class="nav-menu-item" href="/game">Подбор пар</a>
                </div>
            </div>
            <div class="nav-menu nav-menu-games">
                <a class="nav-section-link nav-menu-trigger @(currentPath.StartsWith("/games") ? "is-current" : "")" href="/games" aria-controls="games-menu" aria-haspopup="true" aria-expanded="false">Игры</a>
                <div id="games-menu" class="nav-menu-panel" aria-label="Игры">
                    <a class="nav-menu-item" href="/games/crosswords">Кроссворды</a>
                    <a class="nav-menu-item" href="/games/wordle">Пять букв</a>
                    <span class="nav-menu-item nav-menu-item-placeholder"><span>Переводилка</span><small>В разработке</small></span>
                </div>
            </div>
            <a class="@(currentPath.StartsWith("/reading") || currentPath.StartsWith("/books") ? "is-current" : "")" href="/reading">Чтение</a>
            @if (User.Identity?.IsAuthenticated != true) {
                <div class="mobile-account-links"><a class="button primary" href="/account/login">Войти</a><a href="/account/register">Создать аккаунт</a></div>
            }
        </div>@await Html.PartialAsync("_TabletNavigation")</nav>
            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true) {
                    <span class="header-streak-slot"><a id="header-streak" class="header-streak" href="/progress" aria-label="Серия занятий" hidden><img class="header-streak-icon" src="~/images/streak-flame.svg" asp-append-version="true" width="20" height="24" alt="" /><strong id="header-streak-value"></strong><span id="header-streak-label" class="header-streak-label">дней подряд</span></a></span>
                    <a class="profile-action" href="/profile" aria-label="@(User.IsInRole("Editor") ? "Профиль редактора" : "Профиль")"><span class="profile-avatar" aria-hidden="true">@await Html.PartialAsync("_Avatar", new AvatarDisplayModel(await Avatars.Current(User), true))</span><span class="profile-action-label">@(User.IsInRole("Editor") ? "Редактор · профиль" : "Профиль")</span></a>
                } else { <a class="account-action" href="/account/login">Войти</a> }
            </div>
            <button class="mobile-menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" aria-label="Открыть меню"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
        </div>
    </header>
    <button class="menu-backdrop" type="button" aria-label="Закрыть меню" tabindex="-1" hidden></button>
    <main id="main-content" tabindex="-1">
        @if (User.Identity?.IsAuthenticated != true && new[] { "/audio-puzzles", "/translate", "/listening", "/dialogs", "/matching", "/picture", "/books", "/vocabulary", "/word-practice", "/game", "/games", "/games/crosswords", "/games/wordle" }.Contains(currentPath))
        {
            <p class="guest-notice container">@(currentPath.StartsWith("/games") ? "Без входа результаты не сохраняются." : "Занимайтесь без входа. Прогресс и слова не сохраняются.") <a href="/account/login?ReturnUrl=@Uri.EscapeDataString(currentPath)">Войти, чтобы сохранять</a></p>
        }
        @RenderBody()
    </main>
    <form hidden id="api-antiforgery">@Html.AntiForgeryToken()</form>
    <footer class="site-footer">
        <div class="footer-inner">
            <a class="footer-brand" href="/" aria-label="Адам — главная"><img src="/images/adam-mark.svg" width="32" height="28" alt="" />Адам</a>
            <p>Изучайте осетинский в своём темпе</p>
            <nav class="footer-links" aria-label="Информация о сайте"><a href="/home/privacy">Политика конфиденциальности</a><a href="/home/illustrations">Об иллюстрациях</a></nav>
        </div>
    </footer>
    <nav class="mobile-bottom-nav" aria-label="Основные разделы">
        <a class="@(currentPath == "/" || currentPath.StartsWith("/dialogs") || currentPath.StartsWith("/audio-puzzles") || currentPath.StartsWith("/translate") || currentPath.StartsWith("/listening") || currentPath.StartsWith("/matching") || currentPath.StartsWith("/picture") || currentPath.StartsWith("/games") ? "is-current" : "")" aria-current="@(currentPath == "/" ? "page" : null)" href="/">@await Html.PartialAsync("_NavIcon", "home")<span>Задания</span></a>
        <a class="@(currentPath.StartsWith("/vocabulary") || currentPath.StartsWith("/word-practice") || currentPath == "/game" ? "is-current" : "")" aria-current="@(currentPath == "/vocabulary" ? "page" : null)" href="/vocabulary">@await Html.PartialAsync("_NavIcon", "words")<span>Слова</span></a>
        <a class="@(currentPath.StartsWith("/reading") || currentPath.StartsWith("/books") ? "is-current" : "")" aria-current="@(currentPath == "/reading" ? "page" : null)" href="/reading">@await Html.PartialAsync("_NavIcon", "books")<span>Чтение</span></a>
        <a class="@(currentPath.StartsWith("/profile") || currentPath.StartsWith("/account") || currentPath.StartsWith("/progress") ? "is-current" : "")" aria-current="@(currentPath == "/profile" ? "page" : null)" href="/profile">@await Html.PartialAsync("_NavIcon", "profile")<span>Профиль</span></a>
    </nav>
    </div>
    <script src="~/js/nav.js" asp-append-version="true" defer></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/avatar.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true) { <script src="~/js/streak.js" asp-append-version="true" defer></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
