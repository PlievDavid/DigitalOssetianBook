@model IronLanguage.Web.ViewComponents.CourseRatingViewModel
@{
    var own = Model.Summary.UserScore ?? 0;
    var average = Model.Summary.Average?.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"));
}
<section id="course-rating" class="course-rating" aria-labelledby="course-rating-title">
    <div class="course-rating-summary">
        <h2 id="course-rating-title">Оценки курса</h2>
        <p>@(average is null ? "Пока без оценок" : $"★ {average} из 5 · оценок: {Model.Summary.Count}")</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" action="/courses/@Model.CourseId/rating">
            @Html.AntiForgeryToken()
            <fieldset>
                <legend>@(own == 0 ? "Ваша оценка" : $"Ваша оценка: {own} из 5")</legend>
                <div class="course-rating-stars">
                    @for (var score = 1; score <= 5; score++)
                    {
                        <button type="submit" name="score" value="@score" class="@(score <= own ? "is-filled" : null)" aria-label="Поставить @score из 5" aria-pressed="@(score == own ? "true" : "false")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>
                        </button>
                    }
                </div>
            </fieldset>
        </form>
    }
    else { <a href="/account/login?ReturnUrl=%2Fcourses%2F@Model.CourseId%2Fabout%23course-rating">Войти и оценить</a> }
</section>
