@{ ViewData["Title"] = "Повторение слов"; }
@section Styles { <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" /> <link rel="stylesheet" href="~/css/word-review.css" asp-append-version="true" /> }
<section class="feature-shell review-page" id="spaced-review">
    <a class="back-link" href="/vocabulary">← Мои слова</a>
    <header class="words-heading"><h1>Повторение слов</h1><div class="review-header-actions"><button type="button" class="button secondary" id="review-settings-open">Настройки</button></div></header>
    <p id="review-status" class="words-notice" role="status" aria-live="polite"></p>
    <section id="review-start" class="review-setup" hidden>
        <h2>Что повторим?</h2><p class="review-muted">Выберите слова для этого занятия.</p>
        <fieldset class="review-modes"><legend>Режим занятия</legend>
            <label><input type="radio" name="mode" value="due" /><strong>Повторение</strong><small>Закрепить знакомые слова</small><span id="review-count-due"></span></label>
            <label><input type="radio" name="mode" value="new" /><strong>Новые слова</strong><small>Начать изучать добавленное</small><span id="review-count-new"></span></label>
            <label><input type="radio" name="mode" value="mixed" checked /><strong>Всё вместе</strong><small>Повторять и узнавать новое</small><span id="review-count-mixed"></span></label>
        </fieldset>
        <div class="review-start-actions"><button type="button" class="button primary" id="review-begin">Начать повторение</button><button type="button" class="button secondary" id="review-resume" hidden>Продолжить занятие</button><a class="button secondary" id="review-add-words" href="/vocabulary/available" hidden>Добавить слова</a></div>
        <p id="review-start-note" class="review-muted"></p>
    </section>
    <section id="review-study" hidden aria-label="Занятие">
        <div class="review-progress"><span id="review-step"></span><progress id="review-progress-bar" value="0" max="1" aria-label="Проверено карточек"></progress><button type="button" class="review-link" id="review-exit">Закончить</button></div>
        <div class="review-stage">
            <div id="review-flashcard" class="review-flashcard" hidden>
                <button type="button" class="review-flip" id="review-flip" aria-label="Перевернуть карточку" aria-expanded="false">
                    <span class="review-flip-inner"><span class="review-face review-front"><span id="review-direction"></span><strong id="review-prompt"></strong><span class="review-flip-hint">Вспомните перевод</span></span><span class="review-face review-back" aria-hidden="true"><span>Перевод</span><strong id="review-translation"></strong><span id="review-original"></span></span></span>
                </button>
                <div class="review-card-controls"><button class="button primary" type="button" id="review-reveal">Показать перевод</button><div id="review-rating" class="review-rating" hidden><button type="button" class="button secondary" id="review-unknown">Не знаю</button><button type="button" class="button primary" id="review-known">Знаю</button></div></div>
            </div>
            <form id="review-check-form" class="review-check" hidden>
                <p id="review-test-direction" class="review-muted"></p><h2 id="review-test-prompt"></h2><p id="review-choice-days" class="review-muted"></p>
                <fieldset id="review-options" class="review-options" hidden><legend class="visually-hidden">Выберите перевод</legend></fieldset>
                <div id="review-input-wrap" hidden><label for="review-input">Ваш ответ</label><div class="review-input-row"><input id="review-input" maxlength="1000" autocomplete="off" /><button type="button" class="button secondary" id="review-letter" aria-label="Вставить осетинскую букву ӕ">ӕ</button></div></div>
                <button type="submit" class="button primary" id="review-check">Проверить</button>
            </form>
            <section class="review-pairs game-shell" id="review-pairs" hidden><h2>Подберите пары</h2><p id="review-pairs-instructions" class="review-muted">Соедините слова с переводами: протяните нитки или нажимайте по очереди.</p><div id="review-pairs-board" class="game-board"></div><p id="review-pairs-status" role="status"></p><button type="button" class="button primary" id="review-pairs-check" disabled>Проверить пары</button></section>
            <p id="review-feedback" role="status"></p>
            <div class="review-step-actions"><button type="button" class="button primary" id="review-next" hidden>Далее</button><button type="button" class="review-link" id="review-skip" title="Слово вернётся в следующем занятии">Пропустить</button></div>
        </div>
    </section>
    <section id="review-finish" class="review-finish" hidden><h2 tabindex="-1" id="review-finish-title">Готово на сейчас</h2><dl id="review-totals"></dl><a class="button primary" href="/vocabulary">К моим словам</a><button type="button" class="review-link" id="review-again">Ещё одно занятие</button></section>
    <dialog id="review-settings" class="review-settings"><form id="review-settings-form"><h2>Настройки повторения</h2><p class="review-muted">Сначала — знакомство с новым словом. Незнакомые слова закрепляем заданиями.</p><label class="review-direct"><input type="checkbox" name="directInput" /> Сразу вводить перевод</label><p class="review-muted">Для незнакомых слов пропускать выбор вариантов и подбор пар. Изменения начнут действовать со следующего занятия.</p><p id="review-settings-error" role="status"></p><div class="review-settings-actions"><button class="button primary" type="submit">Сохранить</button><button type="button" class="button secondary" id="review-settings-close">Отмена</button></div></form></dialog>
</section>
@section Scripts { <script src="~/js/word-display.js" asp-append-version="true" defer></script><script src="~/js/review-pairs.js" asp-append-version="true" defer></script><script src="~/js/word-practice.js" asp-append-version="true" defer></script> }
