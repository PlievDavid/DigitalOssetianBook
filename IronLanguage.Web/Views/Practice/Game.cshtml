@{ ViewData["Title"] = "Подбор пар"; }
<section class="feature-shell game-shell" id="game-app">
    <a class="back-link" href="/vocabulary">← К словарю</a>
    <div class="game-page-heading">
        <div><h1>Подберите пары</h1><p>Найдите осетинские слова и их переводы.</p></div>
        <button id="game-restart" class="button secondary" hidden>Новая игра</button>
    </div>
    <div id="game-status" role="status"></div>
    <div id="game-board" class="game-board"></div>
    <a id="game-find-words" class="button secondary" href="/vocabulary" hidden>К словарю</a>
</section>
@section Scripts { <script src="~/js/game.js" asp-append-version="true" defer></script> }
