@{ ViewData["Title"] = "Мои слова"; }
@section Styles { <link rel="stylesheet" href="~/css/word-review.css" asp-append-version="true" /> }
<section class="feature-shell words-page" id="my-words-list" data-kind="saved">
    <header class="words-heading">
        <div><h1>Мои слова</h1><p id="words-total">Ваш личный словарь</p></div>
        <div class="words-actions"><a class="button primary" href="/word-practice">Повторить <span id="words-due-count"></span></a><a class="button secondary" href="/vocabulary/available">Новые слова</a></div>
    </header>
    <nav class="words-tabs" id="words-counts" aria-label="Состояние слов"></nav>
    <form id="words-search" class="words-tools" role="search">
        <label class="words-search-field"><span class="words-sr">Найти слово или перевод</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input type="search" name="search" maxlength="100" placeholder="Найти слово или перевод" /></label>
        <input type="hidden" name="status" value="all" />
        <input type="hidden" name="sort" value="due" />
        <details class="words-sort-control" id="words-sort-menu"><summary class="words-sort-trigger" aria-haspopup="menu"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16M4 12h11M4 18h6"/></svg><span id="words-sort-label">Пора повторить</span><svg class="words-sort-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m7 10 5 5 5-5"/></svg></summary><div class="words-sort-options" role="menu" aria-label="Сортировка"><button type="button" role="menuitemradio" aria-checked="true" data-sort="due">Пора повторить</button><button type="button" role="menuitemradio" aria-checked="false" data-sort="recent">Недавно добавленные</button><button type="button" role="menuitemradio" aria-checked="false" data-sort="alphabet">По алфавиту</button><button type="button" role="menuitemradio" aria-checked="false" data-sort="errors">Сначала трудные</button></div></details>
        <button class="button secondary words-search-submit" type="submit">Найти</button>
    </form>
    <p id="words-status" class="words-notice" role="status"></p>
    <div class="words-table-head" aria-hidden="true"><span>Слово</span><span>Перевод</span><span>Статус</span><span></span></div>
    <div id="words-results" class="words-rows" aria-live="polite"></div>
    <nav id="words-pagination" class="words-pagination" aria-label="Страницы словаря"></nav>
    <dialog id="words-remove-dialog" class="words-dialog"><form method="dialog"><h2>Удалить слово?</h2><p id="words-remove-copy"></p><p class="words-secondary">Прогресс повторения этого слова будет сброшен.</p><div class="words-dialog-actions"><button class="button secondary" value="cancel">Оставить</button><button class="button primary" id="words-remove-confirm" value="confirm">Удалить</button></div></form></dialog>
</section>
@section Scripts { <script src="~/js/word-display.js" asp-append-version="true" defer></script><script src="~/js/my-words.js" asp-append-version="true" defer></script> }
