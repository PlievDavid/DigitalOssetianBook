@{
    ViewData["Title"] = "Задания";

    var groups = new (string Id, string Name, (string Path, string Icon, string Title, string Description)[] Exercises)[]
    {
        ("listen", "Понимание на слух", [
            ("/audio-puzzles", "audio", "Аудиопазлы", "Соберите услышанную фразу из слов."),
            ("/listening", "listening", "Аудирование", "Послушайте запись и выберите ответ."),
            ("/dialogs", "dialogs", "Диалоги", "Подберите реплику собеседнику.")
        ]),
        ("phrases", "Построение фраз", [
            ("/translate", "translate", "Собери фразу", "Соберите осетинский перевод из слов."),
            ("/grammar", "grammar", "Форма слова", "Выберите форму, которая подходит к предложению.")
        ]),
        ("words", "Словарный запас", [
            ("/matching", "matching", "Соотнесение", "Найдите пары для слов и выражений."),
            ("/picture", "picture", "Картинка и слово", "Подберите слово к картинке."),
            ("/grouping", "grouping", "Группировка слов", "Разложите слова по общим признакам.")
        ])
    };
}

<div class="exercises-shell">
    <header class="exercises-heading">
        <h1>Задания</h1>
        <p>Прислушайтесь к языку, соберите фразу или найдите новое слово.</p>
    </header>

    <div class="exercise-tracks">
        @foreach (var group in groups)
        {
            <section class="exercise-category" aria-labelledby="category-@group.Id">
                <h2 id="category-@group.Id">@group.Name</h2>
                <div class="exercise-catalog-grid">
                    @foreach (var exercise in group.Exercises)
                    {
                        <a class="exercise-catalog-card" href="@exercise.Path">
                            <span class="exercise-catalog-icon" aria-hidden="true">@await Html.PartialAsync("_NavIcon", exercise.Icon)</span>
                            <div>
                                <h3>@exercise.Title</h3>
                                <p>@exercise.Description</p>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/exercise-catalog.css" asp-append-version="true" /> }
