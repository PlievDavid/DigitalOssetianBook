@{
    ViewData["Title"] = "Задания";

    var groups = new (string Id, string Name, (string Path, string Title)[] Exercises)[]
    {
        ("listen", "На слух", [
            ("/audio-puzzles", "Аудиопазлы"),
            ("/listening", "Аудирование"),
            ("/dialogs", "Диалоги")
        ]),
        ("phrases", "Фразы", [
            ("/translate", "Собери фразу"),
            ("/grammar", "Форма слова")
        ]),
        ("words", "Слова", [
            ("/matching", "Соотнесение"),
            ("/picture", "Картинка и слово"),
            ("/grouping", "Группировка слов")
        ])
    };
}

<div class="exercises-shell">
    <header class="exercises-heading">
        <h1>Задания</h1>
    </header>

    <div class="exercise-tracks">
        @foreach (var group in groups)
        {
            <section class="exercise-category" aria-labelledby="category-@group.Id">
                <h2 id="category-@group.Id">@group.Name</h2>
                <ul class="exercise-catalog-list">
                    @foreach (var exercise in group.Exercises)
                    {
                        <li><a class="exercise-catalog-link" href="@exercise.Path">@exercise.Title</a></li>
                    }
                </ul>
            </section>
        }
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/exercise-catalog.css" asp-append-version="true" /> }
