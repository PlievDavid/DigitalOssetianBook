@{
    ViewData["Title"] = "Осетинский становится ближе";
    ViewData["PageClass"] = "home-page";
}
<div class="home-shell">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="hero-copy">
            <div class="hero-mobile-art" aria-hidden="true"><img src="~/images/green/kurt-tag-watercolor.png" asp-append-version="true" width="1086" height="1448" alt="" /></div>
            <h1 id="home-title">Осетинский<br />становится ближе</h1>
            <p>Читайте, сохраняйте новые слова и проверяйте себя.</p>
            <div class="hero-actions">
                <a class="theme-button theme-button-primary" href="#practice-formats">Начать заниматься <span aria-hidden="true">→</span></a>
                <a class="theme-button theme-button-secondary" href="/books">Открыть книги</a>
            </div>
            <small class="hero-note">В своём темпе · Бесплатно</small>
        </div>
    </section>
    <div class="home-content">
        <section id="practice-formats" class="home-formats" tabindex="-1" aria-labelledby="formats-title">
            <h2 id="formats-title">Как будем учиться</h2>
            <div class="format-grid">
                <a class="format-card format-audio" href="/audio-puzzles">
                    <span class="format-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 20v-5a11 11 0 0 1 22 0v5"/><rect x="4" y="17" width="5" height="11" rx="2" fill="currentColor"/><rect x="23" y="17" width="5" height="11" rx="2" fill="currentColor"/></svg></span>
                    <h3>Аудиопазлы</h3><p>Соберите услышанную фразу</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
                <a class="format-card format-translate" href="/translate">
                    <span class="format-icon translation-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 10h20m-6-6 6 6-6 6M26 22H6m6-6-6 6 6 6"/></svg></span>
                    <h3>Перевод фраз</h3><p>Тренируйте понимание</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
                <a class="format-card format-dialogs" href="/dialogs">
                    <span class="format-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 5h22v16H15l-7 6v-6H5z"/><path d="M10 11h12M10 16h8"/></svg></span>
                    <h3>Диалоги</h3><p>Отвечайте собеседнику</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>
        <section class="home-reading" aria-labelledby="reading-title">
            <h2 id="reading-title">От чтения к тренировке</h2>
            <div class="home-learning-grid">
                <article class="home-reading-card">
                    <span class="reading-step">Шаг 1</span>
                    <h3>Читайте и сохраняйте слова</h3>
                    <p>Откройте книгу, нажмите на незнакомое слово и узнайте перевод. После входа его можно добавить в свой словарь.</p>
                    <a class="theme-button theme-button-primary" href="/books">Выбрать книгу <span aria-hidden="true">→</span></a>
                </article>
                <aside class="home-words-card" aria-labelledby="words-title">
                    <img src="~/images/green/book.png" asp-append-version="true" alt="" width="160" height="160" />
                    <span class="reading-step">Шаг 2</span><h3 id="words-title">Повторяйте в тренировке</h3>
                    <p>@(User.Identity?.IsAuthenticated == true ? "Проверьте, какие переводы вы запомнили: тренировка использует слова из вашего словаря." : "Войдите, чтобы повторять сохранённые слова. Без входа можно попробовать тренировку с опубликованными словами.")</p>
                    <a class="theme-button theme-button-secondary" href="/word-practice"><span class="words-action-label">Тренировать слова</span> <span aria-hidden="true">→</span></a>
                </aside>
            </div>
        </section>
    </div>
</div>
