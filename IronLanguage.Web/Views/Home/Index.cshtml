@{
    ViewData["Title"] = "Осетинский становится ближе";
    ViewData["PageClass"] = "home-page";
}
<div class="home-shell">
    <section class="home-hero" aria-labelledby="home-title">
        <img class="home-hero-art" src="~/images/green/kurt-tag-watercolor-440.webp"
             srcset="/images/green/kurt-tag-watercolor-440.webp 440w, /images/green/kurt-tag-watercolor-880.webp 880w"
             sizes="(max-width: 599px) 44vw, (max-width: 700px) calc(100vw - 32px), (max-width: 1000px) 42vw, 420px"
             width="880" height="1173" fetchpriority="high" loading="eager" decoding="async" alt="" />
        <div class="hero-copy">
            <span class="home-hero-signature"><img src="~/images/adam-mark.svg" alt="" width="24" height="20" /> Адам</span>
            <h1 id="home-title">Осетинский<br />становится ближе</h1>
            <p>Читайте, сохраняйте новые слова и проверяйте себя.</p>
            <div class="hero-actions">
                <a class="theme-button theme-button-primary" href="/exercises">Начать заниматься <span aria-hidden="true">→</span></a>
                <a class="theme-button theme-button-secondary" href="/reading">Перейти к чтению</a>
            </div>
            <small class="hero-note">В своём темпе · Бесплатно</small>
        </div>
    </section>
    <div class="home-content">
        <section id="practice-formats" class="home-formats home-motion-section" tabindex="-1" aria-labelledby="formats-title">
            <h2 id="formats-title">Как будем учиться</h2>
            <div class="format-grid">
                <a class="format-card format-dialogs" href="/courses">
                    <span class="format-icon" aria-hidden="true">@await Html.PartialAsync("_NavIcon", "materials")</span>
                    <h3>Курсы</h3><p>От теории к практике по порядку</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
                <a class="format-card format-audio" href="/exercises">
                    <span class="format-icon" aria-hidden="true">@await Html.PartialAsync("_NavIcon", "audio")</span>
                    <h3>Задания</h3><p>Слушайте, собирайте фразы и тренируйте слова</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
                <a class="format-card format-translate" href="/reading">
                    <span class="format-icon translation-icon" aria-hidden="true">@await Html.PartialAsync("_NavIcon", "books")</span>
                    <h3>Чтение</h3><p>Читайте по-осетински и сохраняйте новые слова</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>
        <section id="games" class="home-games home-motion-section" tabindex="-1" aria-labelledby="games-title">
            <h2 id="games-title"><a href="/games">Игры со словами →</a></h2>
            <div class="format-grid home-games-grid">
                <a class="format-card format-crosswords" href="/games/crosswords">
                    <span class="format-icon crossword-format-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M10 4h6v6h12v6H16v12h-6V16H4v-6h6Z"/><path d="M10 10h6v6h-6ZM22 10v6M10 22h6"/></svg></span>
                    <h3>Кроссворды</h3><p>Десять тем для знакомства со словами</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
                <a class="format-card format-wordle" href="/games/wordle">
                    <span class="format-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="24" height="24" rx="4"/><path d="M12 4v24M20 4v24M4 12h24M4 20h24"/></svg></span>
                    <h3>Пять букв</h3><p>Осетинское слово дня</p><span class="round-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>
        <section class="home-reading reading-flow home-motion-section" aria-labelledby="reading-title">
            <h2 id="reading-title">От чтения к тренировке</h2>
            <div class="home-learning-grid">
                <article class="home-reading-card">
                    <span class="reading-step"><span class="reading-step-icon">@await Html.PartialAsync("_NavIcon", "books")</span> Читайте</span>
                    <h3>Нашли новое слово?</h3>
                    <p>Нажмите на него в тексте и сохраните перевод в свой словарь после входа.</p>
                    <a class="theme-button theme-button-primary" href="/reading">Выбрать произведение <span aria-hidden="true">→</span></a>
                </article>
                <aside class="home-words-card" aria-labelledby="words-title">
                    <span class="reading-step"><span class="reading-step-icon">@await Html.PartialAsync("_NavIcon", "words")</span> Закрепляйте</span><h3 id="words-title">Проверьте, что запомнили</h3>
                    <p>@(User.Identity?.IsAuthenticated == true ? "Повторяйте сохранённые слова в короткой тренировке: посмотрите слово и вспомните перевод." : "Повторяйте свои слова после входа. Или попробуйте тренировку без аккаунта.")</p>
                    <a class="theme-button theme-button-primary" href="/word-practice"><span class="words-action-label">Тренировать слова</span> <span aria-hidden="true">→</span></a>
                </aside>
            </div>
        </section>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/home-reading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-front.css" asp-append-version="true" />
}
@section Scripts { <script src="~/js/home-motion.js" asp-append-version="true" defer></script> }
